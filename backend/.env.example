# Server
PORT=8083

# Database (Supabase -> Settings -> Database -> Connection string -> URI)
DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres

# API Authentication (generate: openssl rand -hex 32)
API_KEY=your-random-api-key-here

# Telegram Bot
# 1. Open Telegram -> search @BotFather -> /newbot
# 2. Get token (looks like: 1234567890:ABCDef...)
# 3. Send a message to your bot, then visit:
#    https://api.telegram.org/bot<TOKEN>/getUpdates
#    to find your chat_id
TELEGRAM_BOT_TOKEN=1234567890:ABCDefGHIjklMNOpqrSTUvwxYZ
TELEGRAM_CHAT_ID=123456789

# Google Cloud (Phase 3 - Cloud Tasks / Cloud Run)
GCP_PROJECT_ID=your-gcp-project-id
GCP_LOCATION=us-central1
CLOUD_TASKS_QUEUE=price-tracker-queue
WORKER_URL=https://price-tracker-backend-xyz-uc.a.run.app/scrape/work

# Web Push VAPID keys (generate: npx web-push generate-vapid-keys)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_EMAIL=mailto:you@example.com

NODE_ENV=development
